    "truth_access": "Every method receives the scenario's declared fitted_Q, which equals true_Q in correctly specified baselines. Only method IDs beginning with oracle_ may use additional generating parameters beyond that supplied input; no method may use molecule identity truth.",
    "hard_tie_rule": "Divide one molecule count equally across exact maximum-likelihood ties; for top-label accuracy choose the lowest candidate index and report the tie rate.",
    "binary_rule": "Retain every candidate in the minimum observed-cycle Hamming-mismatch stratum.",
    "joint_abundance_emission_fit_in_v1": false
  },
  "bootstrap": {
    "method": "em_fixed_q",
    "eligible_primary_scenarios": [
      "B0_complete",
      "B1_mcar02",
      "B2_mcar10",
      "B3_cycle18_drop",
      "B4_anti4R_drop",
      "B5_mnar_call_dependent"
    ],
    "resampling_unit": "independent_molecule",
    "implementation": "For trace-likelihood-class counts n, draw n_star from Multinomial(N, n/N), reuse the class likelihood matrix, and refit from the original point estimate.",
    "primary_resamples": 250,
    "debug_resamples": 25,
    "confidence_level": 0.95,
    "interval_type": "equal_tailed_percentile",
    "quantile_method": "linear",
    "conditional_on": [
