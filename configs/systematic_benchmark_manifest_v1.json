      "fixed_candidate_dictionary",
      "realized_cycle_or_probe_availability"
    ],
    "outer_calibration_bootstrap_in_v1": false,
    "minimum_success_fraction": 0.98,
    "coverage_estimands": [
      "six_isoform_totals",
      "seven_PTM_marginals",
      "singleton_observable_active_candidates_with_expected_count_at_least_20",
      "exact_observable_group_totals_containing_an_active_candidate"
    ],
    "coverage_summary": "Report successes/attempts, empirical coverage, mean and median width, and a Wilson 95% interval for coverage across Monte Carlo seeds."
  },
  "stopping_and_failures": {
    "em": {
      "initialization": "uniform_over_fitted_candidates",
      "max_iterations": 500,
      "relative_objective_tolerance": 1e-08,
      "maximum_weight_change_tolerance": 1e-08,
      "consecutive_qualifying_iterations": 1,
      "block_size": 4096,
      "return_responsibilities_during_abundance_fit": false,
      "monotonicity_tolerance": "1e-10 * (1 + abs(previous centered log likelihood))",
      "terminal_fixed_point_residual_maximum": 1e-07,
      "retry_once_if_nonconverged": {
        "max_iterations": 1000,
        "initialization": "normalize(top_likelihood_equal_tie_counts + 0.5)"
      }
    },
    "run_status_values": [
      "ok",
      "nonconverged",
      "numerical_failure",
      "exception",
      "resource_skipped",
      "not_applicable"
    ],
    "invalid_run_rule": "Do not calculate comparative metrics after nonconvergence, nonfinite output, failed normalization, excessive terminal residual, or a monotonicity violation beyond tolerance.",
    "seed_replacement": false,
    "primary_summary_minimum_valid_seed_pairs": 18,
    "headline_rule": "A scenario or paired contrast with fewer than 18 of 20 valid seed pairs is not headline-eligible and must retain its failure rows.",
    "systematic_failure_stop": "After three failures with the same scenario and failure code, stop scheduling that scenario, continue unrelated scenarios, and require a code/configuration audit before a versioned rerun.",
    "configuration_change_rule": "Never edit a frozen manifest in place after execution; issue a new manifest_id and retain both archives."
